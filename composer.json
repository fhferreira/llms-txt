{
    "name": "fhferreira/llms-txt",
    "description": "Generate llms.txt and llms-full.txt for routes tagged with the `llms` middleware. Laravel package designed to make APIs LLM-consumable per the llmstxt.org spec.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "llms.txt", "openapi", "documentation", "ai", "llm"],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Fhferreira\\LlmsTxt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fhferreira\\LlmsTxt\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fhferreira\\LlmsTxt\\LlmsTxtServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
